digraph G {
  graph [
    rankdir=TB,
    bgcolor="#F8FAFC",
    fontname="DejaVu Sans",
    fontsize=20,
    labelloc=t,
    label=<<B>Propuesta de interoperabilidad .NET-Java</B><BR/><FONT POINT-SIZE="11" COLOR="#475569">FinanTech S.A. - migración gradual, JSON/JWT/TLS y notificaciones asíncronas</FONT>>,
    pad=0.18,
    nodesep=0.35,
    ranksep=0.38,
    newrank=true
  ];
  node [
    shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
    margin="0.10,0.07", penwidth=1.3, color="#94A3B8", fillcolor="#FFFFFF", fontcolor="#0F172A"
  ];
  edge [
    fontname="DejaVu Sans", fontsize=8.5, color="#64748B", fontcolor="#475569",
    arrowsize=0.6, penwidth=1.1
  ];

  subgraph cluster_clientes {
    label=<<B>1 - Clientes (Windows 85 %)</B>>;
    fontsize=10; fontcolor="#1E3A8A"; style="rounded,dashed"; color="#93C5FD"; bgcolor="#EFF6FF"; margin=7;
    usuario [label=<<B>Usuarios y sucursales</B>>, fillcolor="#DBEAFE", color="#3B82F6"];
    cnet    [label=<<B>Cliente .NET 8</B><BR/>HttpClient + WCF>, fillcolor="#FFFFFF", color="#3B82F6"];
    { rank=same; usuario; cnet; }
  }

  gateway [
    label=<<B>2 - API Gateway / WAF</B><BR/>TLS 1.2/1.3 - JWT - rate limiting>,
    fillcolor="#0F172A", fontcolor="#FFFFFF", color="#0F172A", penwidth=2
  ];

  java [
    label=<<B>3 - Core Java - Spring Boot 3.3</B><BR/>/api/v1 - JWT - idempotencia<BR/>H2 demo / PostgreSQL prod>,
    fillcolor="#DCFCE7", color="#16A34A", penwidth=2
  ];
  wcf [
    label=<<B>3 - Servicio WCF - CoreWCF</B><BR/>SOAP 1.1 - WSDL - FaultContract<BR/>almacén demo / SQL Server>,
    fillcolor="#F3E8FF", color="#9333EA", penwidth=2
  ];

  mail [label=<<B>MailHog / SMTP</B><BR/>correo @Async - 1 000 alertas/día>, fillcolor="#FEF3C7", color="#D97706"];
  obs  [label=<<B>Observabilidad</B><BR/>OpenTelemetry - p50 / p95 / p99>, fillcolor="#E0F2FE", color="#0284C7"];

  usuario -> cnet [label="HTTPS"];
  cnet -> gateway [label="JSON + JWT\nSOAP 1.1"];
  gateway -> java [label="REST / JSON"];
  gateway -> wcf  [label="SOAP / XML"];
  java -> mail [label="evento", color="#D97706", fontcolor="#92400E"];
  java -> obs  [style=dotted, constraint=false, color="#0284C7"];
  wcf  -> obs  [style=dotted, constraint=false, color="#0284C7"];

  { rank=same; java; wcf; }
  { rank=same; mail; obs; }
}
